# Primary OpenAI-compatible chat model.
# DeepSeek example:
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=replace-with-your-key
LLM_MODEL=deepseek-chat

# Optional fallback, tried automatically when the primary call fails.
# BigModel / Zhipu example:
# LLM_FALLBACK_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_FALLBACK_API_KEY=replace-with-your-key
# LLM_FALLBACK_MODEL=glm-4-flash

# Optional local Ollama fallback (the app also probes 127.0.0.1:11434 by default).
# OLLAMA_MODEL=qwen2.5:3b

# Vector database similarity search: text embedding endpoint.
# Ollama example (nomic-embed-text produces 768-d vectors):
EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_API_KEY=

# Optional guardrails.
# WREN_INSIGHT_MAX_ROWS=500
# WREN_INSIGHT_REPAIR_ATTEMPTS=2
# WREN_INSIGHT_QUERY_TIMEOUT=60
# WREN_INSIGHT_VECTOR_MAX_SCAN=5000
# WREN_INSIGHT_VECTOR_MAX_TOP_K=50
